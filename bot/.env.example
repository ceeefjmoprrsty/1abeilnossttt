# Шаблон: скопируйте в .env и заполните своими значениями.
# BOT_TOKEN — получить у @BotFather (/newbot или /revoke)
BOT_TOKEN=
# ADMIN_IDS — ваш числовой Telegram ID через запятую (узнать у @userinfobot)
ADMIN_IDS=
# Прокси только если Telegram недоступен напрямую
# PROXY_URL=socks5://127.0.0.1:10808
